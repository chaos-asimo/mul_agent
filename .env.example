# mul_agent 环境变量配置示例
# 复制为 .env 并按需修改

# ============ 基础配置 ============
# 宿主机映射端口（容器内固定 8888）
HOST_PORT=8888

# 时区
TZ=Asia/Shanghai

# ============ 安全配置 ============
# Session 密钥，生产环境务必修改为随机字符串（如 openssl rand -hex 32）
# 修改后所有已登录用户需重新登录
SESSION_SECRET_KEY=mul_agent_secret_key_2026

# ============ 管理员账号（首次启动 bootstrap 使用） ============
# 仅 users 表为空时生效，之后可在「用户管理」页修改密码
# 生产环境务必修改为强密码
MU_ADMIN_USERNAME=shineyue
MU_ADMIN_PASSWORD=shineyue@2026
