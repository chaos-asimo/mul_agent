# mul_agent 环境变量配置示例
# 复制为 .env 并按需修改

# ============ 基础配置 ============
# 宿主机映射端口（容器内固定 8888）
HOST_PORT=8888

# 时区
TZ=Asia/Shanghai

# ============ 安全配置 ============
# Session 密钥，生产环境务必修改为随机字符串（如 openssl rand -hex 32）
# 修改后所有已登录用户需重新登录
SESSION_SECRET_KEY=mul_agent_secret_key_2026

# 对外 API 认证 Key（X-API-Key 请求头）。逗号分隔可配多个，留空则仅 session 登录可访问
# 生成: openssl rand -hex 16
# 注意: /docs /redoc /openapi.json /api/* 等已接入认证，未配置 API_KEYS 且未登录将返回 401
API_KEYS=

# ============ 管理员账号（首次启动 bootstrap 使用） ============
# 仅 users 表为空时生效，之后可在「用户管理」页修改密码
# 生产环境务必修改为强密码
MU_ADMIN_USERNAME=shineyue
MU_ADMIN_PASSWORD=shineyue@2026

# ============ 直登接口（/api/lobster-mu/login/direct） ============
# 允许跨域调用直登接口的 Origin 列表（逗号分隔）
# 支持 * 通配符，如 *.jbysoft.com 覆盖所有子域名
# 不配置则拒绝所有跨域请求（仅同源 + file:// 可访问）
# file:// 打开的 HTML（Origin=null）始终放行
DIRECT_LOGIN_ALLOWED_ORIGINS=*.jbysoft.com

# ============ 平台 token 身份校验（直登时调用，确认本人操作） ============
# 校验接口地址（GET，query 传 token，返回 grbh 与 username 比对）
PLATFORM_TOKEN_VERIFY_URL=http://10.111.1.250:32516/PT/business/token/getUserInfoViaToken
# 校验失败/接口不可达时是否拒绝登录（默认 true 拒绝；仅调试时可设 false 放行）
PLATFORM_TOKEN_VERIFY_STRICT=true

# ============ 构建期（docker compose build 使用） ============
# 基础镜像源前缀：daocloud 挂掉时切换，备选 docker.1ms.run / docker.xuanyuan.me / docker.aityp.com
REGISTRY=docker.m.daocloud.io
# 沙箱基础镜像（需含源前缀的完整路径）
BASE_IMAGE=langgenius/dify-agent-local-sandbox:1.16.1

# ============ 沙箱（普通用户脚本隔离执行） ============
# 宿主机项目绝对路径（容器内跑沙箱时用于路径映射，docker 部署必填）
HOST_APP_DIR=
# Docker 不可用时的降级策略：deny 拒绝执行（默认）/ warn 放行（仅内网开发环境）
LOBSTER_SANDBOX_FALLBACK=deny
# 彻底关闭沙箱（不建议生产）：LOBSTER_SANDBOX_ENABLED=false
